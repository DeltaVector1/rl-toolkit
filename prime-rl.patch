+            parts_fd = -1
+            _remove_directory_entry(parent_fd, parts_name, "adapter parts directory")
+            parts_fd = _ensure_directory_entry(
+                parent_fd,
+                parts_name,
+                "adapter parts directory",
+            )
+            _write_text_entry_atomic(
+                parts_fd,
+                "manifest.json",
+                json.dumps(identity, separators=(",", ":")),
