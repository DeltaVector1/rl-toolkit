+        return False
+
+
+def _check_cancelled(cancel_event: threading.Event | None) -> None:
+    if cancel_event is not None and cancel_event.is_set():
+        raise TimeoutError("adapter staging was cancelled")
+
+
+def _check_deadline(
+    deadline: float | None,
+    cancel_event: threading.Event | None = None,
+) -> None:
+    _check_cancelled(cancel_event)
+    if deadline is not None and time.monotonic() >= deadline:
+        raise TimeoutError("adapter delta staging exceeded its time limit")
+
+
+def _acquire_stage_lock(
+    lock,
+    deadline: float | None,
+    cancel_event: threading.Event | None = None,
+) -> None:
+    if deadline is None:
+        while True:
+            _check_cancelled(cancel_event)
+            try:
+                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+                return
+            except BlockingIOError:
+                if cancel_event is None:
+                    time.sleep(0.1)
+                else:
+                    cancel_event.wait(0.1)
+    while True:
+        _check_deadline(deadline, cancel_event)
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            return
+        except BlockingIOError:
+            wait_for = min(0.1, max(0.0, deadline - time.monotonic()))
+            if cancel_event is None:
+                time.sleep(wait_for)
+            else:
+                cancel_event.wait(wait_for)
+
+
+def _request_timeout(
+    deadline: float | None,
+    cancel_event: threading.Event | None = None,
+    maximum: float | None = None,
+) -> float:
+    _check_deadline(deadline, cancel_event)
+    timeout = _ADAPTER_LANE_TIMEOUT_S
+    if maximum is not None:
+        if not _is_finite_number(maximum) or maximum <= 0:
+            raise OSError("adapter request timeout must be positive")
+        timeout = min(timeout, float(maximum))
+    if deadline is None:
+        return timeout
+    remaining = deadline - time.monotonic()
+    if remaining <= 0:
+        raise TimeoutError("adapter delta staging exceeded its time limit")
+    return min(timeout, remaining)
+
+
+def _configured_chunk_timeout() -> float:
+    """Return the idle timeout for one resumable adapter chunk request."""
+    if not _is_finite_number(_ADAPTER_CHUNK_TIMEOUT_S) or _ADAPTER_CHUNK_TIMEOUT_S <= 0:
+        raise OSError("PRIME_LORA_CHUNK_TIMEOUT_S must be positive")
+    if not _is_finite_number(_ADAPTER_LANE_TIMEOUT_S) or _ADAPTER_LANE_TIMEOUT_S <= 0:
+        raise OSError("PRIME_LORA_LANE_TIMEOUT_S must be positive")
+    if _ADAPTER_CHUNK_TIMEOUT_S > _ADAPTER_LANE_TIMEOUT_S:
+        raise OSError("PRIME_LORA_CHUNK_TIMEOUT_S cannot exceed PRIME_LORA_LANE_TIMEOUT_S")
+    return _ADAPTER_CHUNK_TIMEOUT_S
+
+
+def _chunk_request_timeout(
+    deadline: float | None,
+    attempt: int,
+    configured_timeout: float,
+    cancel_event: threading.Event | None = None,
+) -> float:
+    """Bound a chunk attempt so a stalled lane can be retried promptly."""
+    timeout = configured_timeout
+    if not _is_finite_number(timeout) or timeout <= 0:
+        raise OSError("adapter request timeout must be positive")
+    if timeout > _ADAPTER_LANE_TIMEOUT_S:
+        raise OSError("adapter request timeout cannot exceed adapter lane timeout")
+    if deadline is None:
+        return timeout
+    _check_deadline(deadline, cancel_event)
+    attempts_left = max(1, _ADAPTER_LANE_RETRIES - attempt)
+    remaining = deadline - time.monotonic()
+    if remaining <= 0:
+        raise TimeoutError("adapter delta staging exceeded its time limit")
+    return min(timeout, remaining, max(0.25, remaining / (attempts_left + 1)))
+
+
+def _wait_for_futures(
+    executor: ThreadPoolExecutor,
+    futures,
+    deadline: float | None,
+    cancel_event: threading.Event | None = None,
+) -> None:
+    try:
+        for future in futures:
+            _check_cancelled(cancel_event)
+            if deadline is None:
+                future.result()
+                _check_cancelled(cancel_event)
+                continue
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise TimeoutError("adapter delta staging exceeded its time limit")
+            try:
+                future.result(timeout=remaining)
+            except FutureTimeoutError as exc:
+                raise TimeoutError("adapter delta staging exceeded its time limit") from exc
+            _check_cancelled(cancel_event)
+    except BaseException:
+        if cancel_event is not None:
+            cancel_event.set()
+        for future in futures:
+            future.cancel()
+        # Do not let the caller clean a path while a worker can still write it.
+        # Socket reads and retry sleeps check the cancellation event and have
+        # bounded timeouts, so this join completes after cancellation.
+        executor.shutdown(wait=True, cancel_futures=True)
+        raise
+    else:
+        executor.shutdown(wait=True)
+
+
+def _content_length(
+    source_url: str,
+    deadline: float | None = None,
+    cancel_event: threading.Event | None = None,
+) -> int:
+    _check_deadline(deadline, cancel_event)
+    with urllib.request.urlopen(
+        urllib.request.Request(source_url, method="HEAD"),
+        timeout=_request_timeout(deadline, cancel_event),
+    ) as response:
+        _check_deadline(deadline, cancel_event)
+        try:
+            return int(response.headers["Content-Length"])
+        except (TypeError, ValueError) as exc:
+            raise OSError(f"adapter source has no valid Content-Length: {source_url}") from exc
+
+
+def _read_source_text(
+    source_url: str,
+    deadline: float | None = None,
+    cancel_event: threading.Event | None = None,
+) -> str:
+    return _read_source_bytes(
+        source_url,
+        deadline=deadline,
+        cancel_event=cancel_event,
+    ).decode("utf-8")
+
+
+def _read_source_bytes(
+    source_url: str,
+    deadline: float | None = None,
+    cancel_event: threading.Event | None = None,
+) -> bytes:
+    _check_deadline(deadline, cancel_event)
+    with urllib.request.urlopen(
+        source_url,
+        timeout=_request_timeout(deadline, cancel_event),
+    ) as response:
+        chunks = []
+        while True:
+            _check_deadline(deadline, cancel_event)
+            chunk = response.read(16 * 1024 * 1024)
+            if not chunk:
+                break
+            chunks.append(chunk)
+        _check_deadline(deadline, cancel_event)
+        return b"".join(chunks)
+
+
+def _source_manifest(
+    source_url: str,
+    deadline: float | None = None,
+    cancel_event: threading.Event | None = None,
+) -> dict[str, object]:
+    """Read the immutable adapter manifest published beside a STABLE marker.
+
+    Older broadcasts have only the model checksum sidecar. Keep that fallback,
+    but always return a local manifest with a size and digest for every file.
+    """
+    source_root = source_url.rstrip("/")
+    _check_deadline(deadline, cancel_event)
+    manifest_url = f"{source_root}/{_ADAPTER_MANIFEST}"
+    try:
+        value = json.loads(
+            _read_source_text(
+                manifest_url,
+                deadline=deadline,
+                cancel_event=cancel_event,
+            )
+        )
+    except HTTPError as exc:
+        if exc.code != 404:
+            raise
+        value = None
+    if value is not None:
+        if not isinstance(value, dict) or value.get("version") not in {1, 2}:
+            raise OSError("invalid adapter source manifest")
