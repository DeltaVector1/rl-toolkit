+++++    res = _fan(nodes, one)
+++++    bad = [h for h, v in res.items() if v != "ok"]
+++++    print(f"{path} -> {len(nodes) - len(bad)}/{len(nodes)} nodes" + (f", FAILED {bad}" if bad else ""))
+++++    if not bad:
