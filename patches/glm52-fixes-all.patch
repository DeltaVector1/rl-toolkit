diff --git a/configs/china/orchestrator.x21.toml b/configs/china/orchestrator.x21.toml
new file mode 100644
index 0000000..35a25dd
--- /dev/null
+++ b/configs/china/orchestrator.x21.toml
@@ -0,0 +1,123 @@
+output_dir = "/data/glm52-rl/runs/x21/run_x21"
+max_steps = 200
+seq_len = 16384
+batch_size = 256
+group_size = 8
+max_inflight_rollouts = 256
+# 4, not 2: batches go out over ZMQ fire-and-forget, so a trainer restart
+# loses whatever was in flight. With a tight cap the orchestrator then holds
+# for a policy the restarted trainer cannot publish and both sides wait
+# forever with the engines idle. Headroom lets it re-supply the trainer.
+max_off_policy_steps = 4
+pool_size = 4
+
+[log]
+level = "info"
+
+[swanlab]
+project = "prod-run"
+name = "orchestrator-x21"
+group = "glm52-decensor-r32"
+tags = ["glm-5.2", "decensor", "grpo", "w8a16-rollouts", "bf16-base-trainer", "lora-r32", "16xh200-rollouts", "56x4090-trainer", "local-gemma", "b1024", "4096", "cp8", "router-replay", "sparse-ada", "norm-adv", "expert-ac"]
+
+[file_monitor]
+filename = "rollout-metrics.jsonl"
+
+[model]
+name = "/data/glm52-rl/model-fp8"
+
+[model.lora]
+name = "glm52-decensor-r32-node-local"
+rank = 32
+alpha = 64
+
+[model.client]
+base_url = [
+    "http://127.0.0.1:18001/v1",
+    "http://127.0.0.1:18002/v1",
+    "http://127.0.0.1:18003/v1",
+    "http://127.0.0.1:18004/v1",
+    "http://127.0.0.1:18005/v1",
+    "http://127.0.0.1:18006/v1",
+    "http://127.0.0.1:18007/v1",
+    "http://127.0.0.1:18008/v1",
+    "http://127.0.0.1:18009/v1",
+    "http://127.0.0.1:18010/v1",
+    "http://127.0.0.1:18011/v1",
+    "http://127.0.0.1:18012/v1",
+    "http://127.0.0.1:18013/v1",
+    "http://127.0.0.1:18014/v1",
+    "http://127.0.0.1:18015/v1",
+    "http://127.0.0.1:18016/v1",
+    "http://127.0.0.1:18017/v1",
+    "http://127.0.0.1:18018/v1",
+    "http://127.0.0.1:18019/v1",
+    "http://127.0.0.1:18020/v1",
+    "http://127.0.0.1:18021/v1",
+    "http://127.0.0.1:18022/v1",
+    "http://127.0.0.1:18023/v1",
+    "http://127.0.0.1:18024/v1",
+]
+admin_base_url = [
+    "http://127.0.0.1:18001/v1",
+    "http://127.0.0.1:18002/v1",
+]
+wait_for_ready_timeout = 7200
+skip_model_check = true
+
+[optim]
+lr = 8e-6
+
+[renderer]
+name = "default"
+tool_parser = "glm"
+reasoning_parser = "think"
+enable_thinking = true
+clear_thinking = true
+
+[train.sampling]
+temperature = 1.0
+max_completion_tokens = 16384
+extra_body = { min_tokens = 16 }
+
+[[train.env]]
+name = "decensor"
+ratio = 1.0
+pool = { type = "static", num_workers = 16 }
+env.taskset.id = "decensor-v1"
+env.taskset.dataset_name = "/data/glm52-rl/decensor-data/rl.jsonl"
+env.taskset.num_examples = 2000
+env.agent.harness = { id = "null", runtime = { type = "subprocess" } }
+env.agent.max_output_tokens = 16384
+env.agent.timeout.rollout = 3600
+
+[train.env.sampling]
+max_completion_tokens = 16384
+
+[train.env.env.taskset.task.judge]
+base_url = "http://127.0.0.1:26406/v1"
+model = "RedHatAI/gemma-4-26B-A4B-it-FP8-dynamic"
+api_key_var = "VLLM_API_KEY"
+
+[train.env.env.taskset.task.user]
+base_url = "http://127.0.0.1:26406/v1"
+model = "RedHatAI/gemma-4-26B-A4B-it-FP8-dynamic"
+api_key_var = "VLLM_API_KEY"
+
+[weight_broadcast]
+type = "filesystem"
+source_url = "http://127.0.0.1:18100/x21"
+source_dir = "/data/glm52-rl/runs/x21"
+
+[rollout_transport]
+type = "zmq"
+host = "10.92.20.82"
+port = 29620
+hwm = 16
+
+[ckpt]
+interval = 25
+resume_step = -1
+skip_progress = true
+keep_last = 2
+keep_interval = 100
