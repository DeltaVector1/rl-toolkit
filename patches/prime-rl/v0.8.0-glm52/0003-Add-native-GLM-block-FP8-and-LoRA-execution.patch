+        with torch.device("meta"):
+            module = cls(
+                linear.in_features,
+                linear.out_features,
+                bias=linear.bias is not None,
+            )
+        module.weight = nn.Parameter(
+            torch.empty_like(linear.weight, dtype=torch.float8_e4m3fn),
+            requires_grad=False,
+        )
+        module.weight_scale_inv = nn.Parameter(
+            torch.empty(
