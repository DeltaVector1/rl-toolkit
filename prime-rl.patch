+    row = tl.program_id(0)
+    pair = tl.arange(0, block)
+    col0 = pair * 2
+    col1 = col0 + 1
+    x0 = tl.load(x + row * cols + col0, mask=col0 < cols, other=0.0).to(tl.float32)
