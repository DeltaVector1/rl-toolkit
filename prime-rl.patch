+                            )
+                        )
+                        for _ in range(n_adapters)
+                    ]
+                ),
+            )
+            setattr(
+                self,
+                f"lora_B_{weight_name}",
+                nn.ParameterList(
+                    [
+                        nn.Parameter(
+                            torch.empty(
+                                out_features,
+                                rank,
+                                device=weight.device,
