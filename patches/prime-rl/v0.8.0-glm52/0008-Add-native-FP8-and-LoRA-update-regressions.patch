+"""CPU autograd and dequantization checks for the Ada FP8 training path."""
+
+from __future__ import annotations
+
+import importlib.util
+import sys
+import types
+import unittest
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+
+REPOSITORY_ROOT = Path(__file__).resolve().parents[3]
+SOURCE_ROOT = (
+    REPOSITORY_ROOT / "source" / "src"
+    if (REPOSITORY_ROOT / "source" / "src").exists()
+    else REPOSITORY_ROOT / "src"
+)
+FP8_ADA_PATH = SOURCE_ROOT / "prime_rl/trainer/models/layers/fp8_ada.py"
+MULTI_LINEAR_PATH = SOURCE_ROOT / "prime_rl/trainer/models/layers/lora/multi_linear.py"
+
+
+def _load_module(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
