@@ -204,6 +205,100 @@ class LogitsProcessor(PluggableLayer):
         top_tokens = gathered[:, :, 1].gather(dim=-1, index=max_rank_idx)
         return top_tokens.squeeze(-1).to(torch.int64)
 
+    def get_selected_token_logprobs(
+        self,
+        lm_head: VocabParallelEmbedding,
+        hidden_states: torch.Tensor,
+        target_token_ids: torch.Tensor,
+        embedding_bias: torch.Tensor | None = None,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        if hidden_states.shape[:-1] != target_token_ids.shape:
+            raise ValueError("target token IDs do not match hidden states")
+        if torch.any(target_token_ids < 0) or torch.any(
+            target_token_ids >= self.org_vocab_size
+        ):
+            raise ValueError("target token ID is outside the model vocabulary")
+
+        flat_hidden = hidden_states.reshape(-1, hidden_states.shape[-1])
+        flat_targets = target_token_ids.reshape(-1)
+        logprobs = torch.empty_like(flat_targets, dtype=torch.float32)
+        ranks = torch.empty_like(flat_targets, dtype=torch.int64)
+        for start in range(0, flat_targets.numel(), 1024):
+            stop = min(start + 1024, flat_targets.numel())
+            logprobs[start:stop], ranks[start:stop] = (
+                self._get_selected_token_logprobs_chunk(
+                    lm_head,
+                    flat_hidden[start:stop],
+                    flat_targets[start:stop],
+                    embedding_bias,
+                )
+            )
+        return logprobs.reshape(target_token_ids.shape), ranks.reshape(
+            target_token_ids.shape
+        )
+
+    def _get_selected_token_logprobs_chunk(
+        self,
+        lm_head: VocabParallelEmbedding,
+        hidden_states: torch.Tensor,
+        target_token_ids: torch.Tensor,
+        embedding_bias: torch.Tensor | None,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        local_logits = self._apply_head(lm_head, hidden_states, embedding_bias)
+        if self.soft_cap is not None:
+            local_logits = torch.tanh(local_logits / self.soft_cap) * self.soft_cap
+        if self.scale != 1.0:
+            local_logits = local_logits * self.scale
+        local_logits = local_logits.float()
+
+        shard = lm_head.shard_indices
+        valid_logits = local_logits[..., : shard.num_org_elements]
+        tp_size = get_tensor_model_parallel_world_size()
+        finite = torch.isfinite(valid_logits).all(dim=-1).to(torch.float32)
+        finite = tensor_model_parallel_all_reduce(finite)
+        if torch.any(finite != tp_size):
+            raise ValueError("selected-token scoring received a nonfinite logit")
+
+        if shard.num_org_elements:
+            local_max = valid_logits.max(dim=-1).values
+        else:
+            local_max = local_logits.new_full(target_token_ids.shape, -float("inf"))
+        gathered_max = tensor_model_parallel_all_gather(
+            local_max.unsqueeze(-1), dim=-1
+        )
+        global_max = gathered_max.max(dim=-1).values
+        local_sum = torch.exp(valid_logits - global_max.unsqueeze(-1)).sum(dim=-1)
+
+        owned = (target_token_ids >= shard.org_vocab_start_index) & (
+            target_token_ids < shard.org_vocab_end_index
+        )
+        local_target = local_logits.new_zeros(target_token_ids.shape)
+        if shard.num_org_elements:
+            local_index = (target_token_ids - shard.org_vocab_start_index).clamp(
+                0, shard.num_org_elements - 1
+            )
+            local_target = torch.where(
+                owned,
+                valid_logits.gather(-1, local_index.unsqueeze(-1)).squeeze(-1),
+                local_target,
+            )
+        totals = tensor_model_parallel_all_reduce(
+            torch.stack((local_sum, local_target, owned.to(torch.float32)), dim=-1)
+        )
+        if torch.any(totals[..., 2] != 1):
+            raise ValueError("target token does not have exactly one vocabulary owner")
+        log_normalizer = global_max + torch.log(totals[..., 0])
+        target_logits = totals[..., 1]
+
+        local_rank = (valid_logits >= target_logits.unsqueeze(-1)).sum(dim=-1)
+        rank = tensor_model_parallel_all_reduce(local_rank.to(torch.float32)).to(
+            torch.int64
+        )
+        logprobs = target_logits - log_normalizer
+        if not torch.isfinite(logprobs).all():
+            raise ValueError("selected-token scoring produced a nonfinite logprob")
+        return logprobs, rank
+
     def extra_repr(self) -> str:
         s = f"vocab_size={self.vocab_size}"
         s += f", org_vocab_size={self.org_vocab_size}"
