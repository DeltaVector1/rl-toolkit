+++++EOF
+++++MAXCYCLES=3 run_tunnel $P24
+++++check "1 miss then healthy -> no kill"            "0"  "$(nkilled)"
+++++
+++++reset; echo 'respond() { [ "$2" = 18007 ] && echo 000 || echo 200; }' > "$FIX/respond.sh"
