+type = "constant"
+
+[weight_broadcast]
+type = "filesystem"
+save_format = "safetensors"
+
+[rollout_transport]
+type = "zmq"
+host = "10.92.20.82"
+port = 29620
+hwm = 16
+
+[ckpt]
+interval = 25
+weights_only = true
+skip_gather_master_weights = true
+keep_last = 2
+keep_interval = 100
+output_dir = "/data/glm52-rl/runs/x13/run_x13"
