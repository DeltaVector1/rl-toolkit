From c99483b1013ae8060a988d789587a3e18a31658f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 6 Aug 2026 06:25:06 +0000
Subject: [PATCH 10/24] Adapter URL must resolve on the ENGINE hosts, not just
 the orchestrator

vLLM engine workers fetch the LoRA adapter themselves
(inference/vllm/worker/filesystem.py stage_lora_adapter -> download), so
source_url is resolved on the H200s, not on the orchestrator host. With
source_url=127.0.0.1:8100 the workers hit Connection refused, and every
failed weight broadcast killed a worker and took EngineCore with it -- the
"engine deaths" were this, not concurrency.

Port 18100 now forwards to the n82 adapter server (8100) on all three hosts,
so one URL works everywhere.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017wiESxhziDrnsLnG9aizTd
---
 configs/china/orchestrator.x21.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/configs/china/orchestrator.x21.toml b/configs/china/orchestrator.x21.toml
index 64b15c5..35a25dd 100644
--- a/configs/china/orchestrator.x21.toml
+++ b/configs/china/orchestrator.x21.toml
@@ -106,7 +106,7 @@ api_key_var = "VLLM_API_KEY"
 
 [weight_broadcast]
 type = "filesystem"
-source_url = "http://127.0.0.1:8100/x21"
+source_url = "http://127.0.0.1:18100/x21"
 source_dir = "/data/glm52-rl/runs/x21"
 
 [rollout_transport]
