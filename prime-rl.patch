+                    lock_name,
+                    os.O_RDWR | os.O_CREAT,
+                    dir_fd=cache_fd,
+                )
+                with os.fdopen(lock_fd, "a+") as reader_lock:
+                    fcntl.flock(reader_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+                    _remove_directory_entry(cache_fd, name, "cached adapter path")
