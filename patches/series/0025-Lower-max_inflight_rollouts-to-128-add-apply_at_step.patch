+++++++rewards(){ sudo docker logs glm52-decensor-orchestrator 2>&1 | sed 's/\x1b\[[0-9;]*m//g' | grep -a "SUCCESS Step" | grep -oE "Reward [0-9.]+" | awk '{print $2}'; }
