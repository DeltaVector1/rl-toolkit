+def _record_judge_audit_failure(
+    failure_reasons: list[str] | None,
+    output: dict[str, Any],
+    reason: str,
+) -> None:
+    if failure_reasons is None:
+        return
+    check = _safe_error(output.get("check", "unknown"))
+    failure_reasons.append(f"check={check}: {_safe_error(reason)}")
