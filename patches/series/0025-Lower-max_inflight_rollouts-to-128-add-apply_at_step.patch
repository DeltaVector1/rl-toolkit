++++@@ -0,0 +1,122 @@
+++++output_dir = "/data/glm52-rl/runs/x13"
+++++max_steps = 200
+++++# 5400, not 1800: at 16K the phantom-shmem pressure pushes nodes into
+++++# transient swap thrash; collectives stall 20-40 min and RECOVER (observed
+++++# blackouts lifting on their own). 1800s converts a recoverable stall into
+++++# a watchdog kill -- three attempts died exactly this way.
