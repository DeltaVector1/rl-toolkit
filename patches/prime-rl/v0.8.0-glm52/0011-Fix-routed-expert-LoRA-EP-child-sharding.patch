From: Codex <codex@local>
Date: Sat, 22 Aug 2026 17:21:39 +0800
Subject: [PATCH] Fix routed expert LoRA EP child sharding

---
 src/prime_rl/trainer/distributed/expert_parallel.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/prime_rl/trainer/distributed/expert_parallel.py b/src/prime_rl/trainer/distributed/expert_parallel.py
index 9fedb8c..60b4dd5 100644
--- a/src/prime_rl/trainer/distributed/expert_parallel.py
+++ b/src/prime_rl/trainer/distributed/expert_parallel.py
@@ -898,6 +898,8 @@ class NativeFP8LoRAAllToAllExpertParallel(MXFP8AllToAllExpertParallel):
         mod: nn.Module,
         device_mesh: DeviceMesh,
     ) -> None:
+        if not getattr(mod, "requires_received_int4_input", False):
+            return
         base_layer = getattr(mod, "base_layer", None)
         if base_layer is None or not getattr(base_layer, "fp8_checkpoint", False):
             raise TypeError("native FP8 LoRA expert parallelism requires an FP8 base layer")
