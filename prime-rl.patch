+        assembling = destination.with_name(f"{destination.name}.assembling")
+        assembling_fd = _open_nofollow(
+            assembling.name,
+            os.O_WRONLY | os.O_CREAT | os.O_TRUNC,
+            dir_fd=parent_fd,
+            label="adapter assembling file",
+        )
