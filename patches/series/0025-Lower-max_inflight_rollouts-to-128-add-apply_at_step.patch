+++++    'import glm52_ops; print(glm52_ops._no_self_match("bash .*tunnel_watchdog.sh"))' 2>/dev/null)
+++++  check "the skill helper brackets the last token" "bash .*[t]unnel_watchdog.sh" "$helper"
+++++fi
