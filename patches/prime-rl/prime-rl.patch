+    @staticmethod
+    def error_label(error: object) -> str | None:
+        if error is None:
+            return None
+        if isinstance(error, dict):
+            for key in ("error_type", "exception_type", "type", "class", "message"):
+                value = error.get(key)
+                if value:
+                    return str(value)
