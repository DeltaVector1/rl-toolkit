--- a/scripts/china/cluster.sh
+++ b/scripts/china/cluster.sh
@@ -155,6 +155,7 @@ case ${1:-} in
       -v "$deployment/source/deps/renderers/renderers/base.py":/app/deps/renderers/renderers/base.py:ro \
