+name = "trainer-x25"
+group = "glm52-decensor-r32"
+tags = ["glm-5.2", "pp7", "decensor", "grpo", "bf16-base", "lora-r32", "56x4090", "b1024", "4096", "cp8", "router-replay", "sparse-ada", "norm-adv", "expert-ac"]
+
+[file_monitor]
+filename = "run_x25/trainer-metrics.jsonl"
+
+[model]
+name = "/data/glm52-rl/model-fp8"
+impl = "custom"
+seq_len = 16384
+attn = "flash_attention_2"
+cp = 8
+pp = 8
+cp_style = "ring"
+ep = 8
+global_ep = false
+dp_replicate = 1
+ep_comm_backend = "torch"
+fsdp_cpu_offload = false
+cold_cpu_offload = false
+optim_cpu_offload = false
+reshard_after_forward = true
+optimization_dtype = "bfloat16"
+reduce_dtype = "bfloat16"
+moe_router_dtype = "float32"
+moe_use_grouped_mm = true
+fused_lm_head_token_chunk_size = 1024
+fp8_embed_head = false
+fp8_lm_head = false
+compile = "None"
+# ac_offloading DEFAULTS TO ENABLED (trainer.py:173 is
+# `ActivationOffloadingConfig()`, not None), and nothing here ever turned it
+# off. It stashes activations in PINNED HOST memory, which is what the
+# [model.ac] note below already warned about: "pinned stashes for 7 in-flight
+# micro-batches x 8 ranks exceeded the 503 GB host RAM and the kernel
+# OOM-killed the trainer on n82". Measured on x18: 60 GB of /dev/zero per rank
+# against 17 GB on the GPU -- 3.5:1, and it tracks micro-batches in flight
+# rather than device memory, which is why FP8 and expandable_segments both
+# failed to move it. 8 ranks x 60 GB = 480 GB on a 503 GB node.
+ac_offloading = "None"
+
+[model.quantization]
+type = "fp8"
+# false is REQUIRED here, not an optimization. Device memory is mirrored 1:1
+# into a MAP_SHARED /dev/zero region per rank (confirmed by smaps: 29.51 GB of
+# /dev/zero against 29110 MiB on the GPU, x8 ranks = the node's 237 GB
+# 'shared'). At 16K the GPUs peak near 60 GB, the mirror reaches ~486 GB and
+# the 503 GB node dies. bf16 weights cost 29 GB/GPU, fp8 cost 15, which halves
+# the mirror. The norms.py override fixes the float8 promotion crash that
+# blocked this before.
+# (was: true costs ~14 GB/GPU because apply_quantization
+# returns early at model.py:1256 so no FP8 kernels run despite type = "fp8").
+# false is the memory-correct setting and loads fine, but dies in the first
+# forward: an FP8 linear emits float8_e4m3fn into the residual stream and
+# RMSNorm.forward (norms.py:44, `self.weight * hidden_states.to(input_dtype)`)
+# raises "Promotion for Float8 Types is not supported, attempted to promote
+# BFloat16 and Float8_e4m3fn". Framework bug in the native-FP8 path for
+# glm_moe_dsa; revisit with a norms/linear dtype fix before flipping again.
+dequantize_checkpoint = true
+
+[model.lora]
+rank = 32
+alpha = 64
+dropout = 0.0
+target_modules = [
+    "q_a_proj",
+    "q_b_proj",
+    "kv_a_proj_with_mqa",
+    "o_proj",
+]
+
+[model.ac]
+# Selective, NOT full: full recompute trips
+# "CheckpointError: Recomputed values ... have different metadata" on this
+# MoE+EP stack, because recompute does not reproduce the per-expert token
+# counts the original forward saw. Memory headroom comes from cp=8 instead.
+mode = "selective"
+freq = 1
+# "norm" checkpoints the two per-layer norms: ~600 MB of activations per
+# 12-layer stage at 16K, vs an x1 OOM shortfall of 242 MiB. CPU offloading
+# is out: pinned stashes for 7 in-flight micro-batches x 8 ranks exceeded
+# the 503 GB host RAM and the kernel OOM-killed the trainer on n82.
+# "mlp" is NOT included: only the 3 dense layers support it, and stages
+# without them reject the target at startup.
+# Every supported target except dense-only "mlp": on this driver the kernel
+# charges DEVICE memory as process shmem, so 8 x GPU_used + real host RAM
+# must stay under 503GB. Checkpointing the attention internals cuts both
+# the direct GPU peak and its 8x host shadow.
+targets = ["attention", "attn_proj", "mla_up_proj", "routed_experts", "norm"]
+
+[optim]
+type = "muon"
+lr = 8e-6
+weight_decay = 0.0
+max_norm = 1.0
+
+[scheduler]
+type = "constant"
+
+[weight_broadcast]
+type = "filesystem"
+save_format = "safetensors"
+
+[rollout_transport]
+type = "zmq"
+host = "10.92.20.82"
+port = 29620
+hwm = 16
+
+[ckpt]
+interval = 5
+# weights_only=true cannot resume training. At interval=25 no checkpoint
+# existed by step 10, so a trainer restart lost every step.
+weights_only = false
+skip_gather_master_weights = true
+keep_last = 2
+keep_interval = 100
+output_dir = "/data/glm52-rl/runs/x25/run_x25"
diff --git a/configs/h200/inference.toml b/configs/h200/inference.toml
index e72de4e..305e4e8 100644
--- a/configs/h200/inference.toml
+++ b/configs/h200/inference.toml
@@ -12,7 +12,10 @@ gpu_memory_utilization = 0.92
 enable_prefix_caching = true
