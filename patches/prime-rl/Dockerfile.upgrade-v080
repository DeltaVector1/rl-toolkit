ARG BASE_IMAGE=prime-rl:glm52-fp8
ARG VLLM_WHEEL_URL=https://github.com/vllm-project/vllm/releases/download/v0.26.0/vllm-0.26.0%2Bcu129-cp38-abi3-manylinux_2_28_x86_64.whl
ARG VLLM_WHEEL_SHA256=6ce4ca30616f0a35810391015622b197a7b8b267ed27f8716f0789db79ff578b
ARG VLLM_ARM_WHEEL_URL=https://github.com/vllm-project/vllm/releases/download/v0.26.0/vllm-0.26.0%2Bcu129-cp38-abi3-manylinux_2_28_aarch64.whl
ARG VLLM_ARM_WHEEL_SHA256=a21f3a78adffce8f3e88b08ad1145ff5d7d6e0618c652db3e0b914c700cd9b64
ARG FLASH_ATTN_WHEEL_URL=https://github.com/mjun0812/flash-attention-prebuild-wheels/releases/download/v0.9.4/flash_attn-2.8.3%2Bcu128torch2.11-cp312-cp312-linux_x86_64.whl
ARG FLASH_ATTN_WHEEL_SHA256=a16162f436286cc03ebbfb174c0853343ed98ae13c37abf1042947668ec40549
ARG SUPPORT_RELEASE_PROXY=""

FROM scratch AS vllm_wheel
ARG VLLM_WHEEL_URL
ARG VLLM_WHEEL_SHA256
ADD --checksum=sha256:${VLLM_WHEEL_SHA256} ${VLLM_WHEEL_URL} /vllm.whl

FROM scratch AS vllm_arm_wheel
ARG VLLM_ARM_WHEEL_URL
ARG VLLM_ARM_WHEEL_SHA256
ADD --checksum=sha256:${VLLM_ARM_WHEEL_SHA256} ${VLLM_ARM_WHEEL_URL} /vllm.whl

FROM scratch AS flash_attn_wheel
ARG FLASH_ATTN_WHEEL_URL
ARG FLASH_ATTN_WHEEL_SHA256
ADD --checksum=sha256:${FLASH_ATTN_WHEEL_SHA256} ${FLASH_ATTN_WHEEL_URL} /flash_attn.whl

FROM scratch AS support_wheels
ARG SUPPORT_RELEASE_PROXY
ADD --checksum=sha256:fdfa7e1f79ed152948fb86330d4fcbf560d7d50fd78d3a96caf83d4bd1b61521 ${SUPPORT_RELEASE_PROXY}https://github.com/PrimeIntellect-ai/prime-rl/releases/download/v0.5.0/deep_ep-1.1.0%2B1fd57b0-cp312-cp312-linux_aarch64.whl /deep_ep-1.1.0+1fd57b0-cp312-cp312-linux_aarch64.whl
ADD --checksum=sha256:a52b709d62c4dfc46a018b988724a7c10894125091aef596bf6d68e94c2b564e ${SUPPORT_RELEASE_PROXY}https://github.com/PrimeIntellect-ai/prime-rl/releases/download/v0.5.0/deep_ep-1.2.1%2B29d31c0-cp312-cp312-linux_x86_64.whl /deep_ep-1.2.1+29d31c0-cp312-cp312-linux_x86_64.whl
ADD --checksum=sha256:a1cbc53414e26b70f9e283e4d57bbe48ba2a3ec84254a72052af8e06f6d0fb1a ${SUPPORT_RELEASE_PROXY}https://github.com/PrimeIntellect-ai/prime-rl/releases/download/v0.5.0/deep_gemm-2.5.0%2B891d57b-cp312-cp312-linux_aarch64.whl /deep_gemm-2.5.0+891d57b-cp312-cp312-linux_aarch64.whl
ADD --checksum=sha256:3a9e4472b86e8e7e2c77cc76951c886bbe7a23a1f5908958969ab5b9c707a2f3 ${SUPPORT_RELEASE_PROXY}https://github.com/PrimeIntellect-ai/prime-rl/releases/download/v0.5.0/deep_gemm-2.5.0%2B891d57b-cp312-cp312-linux_x86_64.whl /deep_gemm-2.5.0+891d57b-cp312-cp312-linux_x86_64.whl
ADD --checksum=sha256:ab8d0da61faa588fd5a7ed947bd58ddb31f5836cf55518bdd0122cfbc83989f4 ${SUPPORT_RELEASE_PROXY}https://github.com/PrimeIntellect-ai/router/releases/download/v0.1.26/vllm_router-0.1.26-cp38-abi3-manylinux_2_28_aarch64.whl /vllm_router-0.1.26-cp38-abi3-manylinux_2_28_aarch64.whl
ADD --checksum=sha256:db0c9410a4c130da8ffeea22f569faca7c85c58c5e183be1ebf758076361a6ec ${SUPPORT_RELEASE_PROXY}https://github.com/PrimeIntellect-ai/router/releases/download/v0.1.26/vllm_router-0.1.26-cp38-abi3-manylinux_2_28_x86_64.whl /vllm_router-0.1.26-cp38-abi3-manylinux_2_28_x86_64.whl
ADD --checksum=sha256:899ee5ac05292a5ffac1e44817c524b63fff850c6d5f679d3087f6770ba628c6 ${SUPPORT_RELEASE_PROXY}https://github.com/PrimeIntellect-ai/prime-rl/releases/download/v0.6.0/torchao-0.17.0%2Bgit02105d46c-cp312-cp312-linux_x86_64.whl /torchao-0.17.0+git02105d46c-cp312-cp312-linux_x86_64.whl
ADD --checksum=sha256:bd01eb9e52f1affee3330062baa2f3bea7d711664f7cb602bf5d3f694daeb796 ${SUPPORT_RELEASE_PROXY}https://github.com/PrimeIntellect-ai/prime-rl/releases/download/v0.5.0/nixl_cu12-0.10.1-cp312-cp312-linux_x86_64.whl /nixl_cu12-0.10.1-cp312-cp312-linux_x86_64.whl

FROM ${BASE_IMAGE}

USER root
WORKDIR /app

ENV UV_PROJECT_ENVIRONMENT=/app/.venv
ENV UV_PYTHON_PREFERENCE=only-system
ENV UV_COMPILE_BYTECODE=0
ENV UV_LINK_MODE=copy

RUN rm -rf /app/src /app/packages /app/deps
COPY pyproject.toml uv.lock README.md /app/
COPY src /app/src
COPY packages /app/packages
COPY deps /app/deps
COPY configs /app/configs
COPY scripts/docker-editable-pretend-versions.sh /app/scripts/docker-editable-pretend-versions.sh
COPY --from=support_wheels /vllm_router-0.1.26-cp38-abi3-manylinux_2_28_x86_64.whl /tmp/vllm_router.whl

ARG VERIFIERS_PRETEND_VERSION=0.2.2.dev76
ARG RENDERERS_PRETEND_VERSION=0.1.9
ARG PYDANTIC_CONFIG_PRETEND_VERSION=0.4.2
ARG QUALIFICATION_ONLY=0
ARG GITHUB_RELEASE_PROXY=""
ARG VLLM_WHEEL_SHA256=6ce4ca30616f0a35810391015622b197a7b8b267ed27f8716f0789db79ff578b
ARG VLLM_ARM_WHEEL_SHA256=a21f3a78adffce8f3e88b08ad1145ff5d7d6e0618c652db3e0b914c700cd9b64
ARG FLASH_ATTN_WHEEL_SHA256=a16162f436286cc03ebbfb174c0853343ed98ae13c37abf1042947668ec40549
RUN --mount=type=cache,target=/root/.cache/uv \
    sed -i "s/fallback-version = \"0.0.0\"/fallback-version = \"${VERIFIERS_PRETEND_VERSION}\"/" /app/deps/verifiers/pyproject.toml \
    && sed -i "s/fallback-version = \"0.0.0\"/fallback-version = \"${RENDERERS_PRETEND_VERSION}\"/" /app/deps/renderers/pyproject.toml \
    && sed -i "s/fallback-version = \"0.0.0\"/fallback-version = \"${PYDANTIC_CONFIG_PRETEND_VERSION}\"/" /app/deps/pydantic-config/pyproject.toml \
    && if [ -n "${GITHUB_RELEASE_PROXY}" ]; then \
        sed -i "s#https://github.com/#${GITHUB_RELEASE_PROXY}https://github.com/#g" /app/uv.lock; \
        git config --global url."${GITHUB_RELEASE_PROXY}https://github.com/".insteadOf "https://github.com/"; \
    fi \
    && sed -i 's/vllm-0.26.0+cu129-cp38/vllm-0.26.0%2Bcu129-cp38/g' /app/uv.lock \
    && sed -i 's/flash_attn-2.8.3+cu128torch2.11-cp312/flash_attn-2.8.3%2Bcu128torch2.11-cp312/g' /app/uv.lock \
    && sed -i 's/deep_ep-1.1.0+1fd57b0-cp312/deep_ep-1.1.0%2B1fd57b0-cp312/g; s/deep_ep-1.2.1+29d31c0-cp312/deep_ep-1.2.1%2B29d31c0-cp312/g; s/deep_gemm-2.5.0+891d57b-cp312/deep_gemm-2.5.0%2B891d57b-cp312/g' /app/uv.lock \
    && sed -i 's/torchao-0.17.0+git02105d46c-cp312/torchao-0.17.0%2Bgit02105d46c-cp312/g' /app/uv.lock \
    && if [ "${QUALIFICATION_ONLY}" = "1" ]; then \
        VIRTUAL_ENV=/app/.venv uv pip install --no-deps -e /app -e /app/packages/prime-rl-configs; \
    else \
        uv sync --package prime-rl --extra flash-attn --frozen --no-dev; \
    fi \
    && VIRTUAL_ENV=/app/.venv uv pip install --no-deps /tmp/vllm_router.whl \
    && /app/.venv/bin/python -c 'from importlib.metadata import version; assert version("prime-rl") == "0.8.0"; assert version("vllm-router") == "0.1.26"'

USER appuser
