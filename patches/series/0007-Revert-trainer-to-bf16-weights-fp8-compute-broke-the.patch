+    "http://127.0.0.1:8000/v1",
+    "http://127.0.0.1:8000/v1",
+    "http://127.0.0.1:8000/v1",
+    "http://127.0.0.1:18101/v1",
+    "http://127.0.0.1:18101/v1",
+    "http://127.0.0.1:18101/v1",
+    "http://127.0.0.1:18101/v1",
+    "http://127.0.0.1:18101/v1",
+    "http://127.0.0.1:18101/v1",
+]
+admin_base_url = [
+    "http://127.0.0.1:8000/v1",
+    "http://127.0.0.1:18101/v1",
+]
+wait_for_ready_timeout = 7200
+skip_model_check = true
