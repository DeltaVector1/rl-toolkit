+    def _project(self, x: torch.Tensor, weight_name: str, scale_name: str) -> torch.Tensor:
+        fqn = getattr(
+            self.base_layer,
+            "_fp8_fqn",
+            "<unassigned-fp8-shared-expert>",
+        )
