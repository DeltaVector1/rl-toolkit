+            raise ValueError("rank and n_adapters must be positive")
+        if n_adapters != 1:
+            raise ValueError("native FP8 routed-expert LoRA supports one run at a time")
+        if dropout != 0.0:
+            raise ValueError("native FP8 routed-expert LoRA requires dropout=0")
