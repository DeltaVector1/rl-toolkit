+    global _PP_GROUP, _IS_STAGE_MASTER
+    _PP_GROUP = pp_group
+    _IS_STAGE_MASTER = is_stage_master
+
+
+def pp_enabled_for_gather() -> bool:
+    return _PP_GROUP is not None
+
