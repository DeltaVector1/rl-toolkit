new file mode 100644
index 0000000..5a7a671
--- /dev/null
+++ b/scripts/ops/notify.sh
@@ -0,0 +1,99 @@
+#!/usr/bin/env bash
+# Telegram notifier for the RL run. Runs on h200a, NOT on n82.
+#
+# n82 cannot reach api.telegram.org at all (http=000) -- Telegram is blocked
+# from the China nodes. h200a reaches it fine, so the notifier lives there and
+# pulls the run state over ssh via the existing china-trainer alias.
+#
+#   per step   -> message with step time, reward, running mean, and health
+#   frozen run -> repeated CALL via CallMeBot (Telegram cannot place calls
+#                 itself; CallMeBot rings your Telegram account)
+#
+# Credentials come from the environment so nothing secret lands in git:
+#   TG_BOT_TOKEN   from @BotFather
+#   TG_CHAT_ID     from @userinfobot ("Id")
+#   CALLMEBOT_KEY  optional; from @CallMeBot_txtbot, enables the phone call
+#
+# Freeze definition: the TRAINER step counter has not advanced and the
+# ORCHESTRATOR batch counter has not advanced for FREEZE_MIN minutes. Both must
+# be stuck -- a slow batch alone is normal and must not page anyone.
+set -uo pipefail
+
+RUN=${RUN:-x22}
+RUN_NAME=${RUN_NAME:-run_$RUN}
+INTERVAL=${INTERVAL:-60}
+FREEZE_MIN=${FREEZE_MIN:-15}
+TG_BOT_TOKEN=${TG_BOT_TOKEN:-}
+TG_CHAT_ID=${TG_CHAT_ID:-}
+CALLMEBOT_KEY=${CALLMEBOT_KEY:-}
+STATE=/root/notify.state
+REMOTE=${REMOTE:-china-trainer}
+rsh() { ssh -o BatchMode=yes -o ConnectTimeout=20 "$REMOTE" "$1" 2>/dev/null; }
+
+log() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $*"; }
+
+send() { # text
+  [ -z "$TG_BOT_TOKEN" ] && { log "TG_BOT_TOKEN unset; would send: $1"; return; }
+  curl -s -m 20 -o /dev/null -X POST \
+    "https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage" \
+    --data-urlencode "chat_id=${TG_CHAT_ID}" \
+    --data-urlencode "text=$1" >/dev/null 2>&1
+}
+
+call() { # text -- rings the phone, for freezes only
+  [ -z "$CALLMEBOT_KEY" ] && { log "CALLMEBOT_KEY unset; no call placed"; return; }
+  curl -s -m 25 -o /dev/null -G "https://api.callmebot.com/start.php" \
+    --data-urlencode "user=@${TG_CHAT_ID}" \
+    --data-urlencode "text=$1" \
+    --data-urlencode "lang=en-US-Standard-B" \
+    --data-urlencode "rpt=2" >/dev/null 2>&1
+}
+
+tsteps() { rsh 'sudo docker logs glm52-decensor-trainer 2>&1 | grep -ac "SUCCESS Step"'; }
+tlast()  { rsh 'sudo docker logs glm52-decensor-trainer 2>&1 | sed "s/\x1b\[[0-9;]*m//g" | grep -a "SUCCESS Step" | tail -1'; }
+rewards(){ rsh 'sudo docker logs glm52-decensor-orchestrator 2>&1 | grep -a "SUCCESS Step" | grep -oE "Reward [0-9.]+"' | awk '{print $2}'; }
+batchn() { rsh 'sudo docker logs --tail 5 glm52-decensor-orchestrator 2>&1 | grep -oE "batch [0-9]+/" | tail -1' | grep -oE "[0-9]+"; }
+
+last_step=$(cat "$STATE" 2>/dev/null || echo 0)
+last_batch=-1
+stuck=0
+frozen_notified=0
+log "notifier started (run=$RUN interval=${INTERVAL}s freeze=${FREEZE_MIN}m)"
+
+while true; do
+  n=$(tsteps 2>/dev/null || echo 0)
+  b=$(batchn 2>/dev/null || echo -1)
+
+  if [ "${n:-0}" -gt "${last_step:-0}" ] 2>/dev/null; then
+    line=$(tlast | grep -oE "Step [0-9]+ \| *[0-9hms ]+\| Loss [^|]*\| Entropy [^|]*\| Grad. Norm [^|]*")
+    rs=$(rewards)
+    mean=$(echo "$rs" | awk 'NF{s+=$1;c++} END{if(c)printf "%.4f (n=%d)",s/c,c; else print "n/a"}')
+    recent=$(echo "$rs" | tail -5 | tr '\n' ' ')
+    send "GLM-5.2 ${RUN} — trainer step ${n}/200
+${line}
+mean reward: ${mean}
+last 5: ${recent}"
+    log "notified step $n"
+    last_step=$n; echo "$n" > "$STATE"
+    stuck=0; frozen_notified=0
+  fi
+
+  # Frozen only if BOTH the step counter and the batch counter are static.
+  if [ "$b" = "$last_batch" ] && [ "${n:-0}" -eq "${last_step:-0}" ]; then
+    stuck=$((stuck + INTERVAL))
+  else
+    stuck=0; frozen_notified=0
+  fi
+  last_batch=$b
+
+  if [ "$stuck" -ge $((FREEZE_MIN * 60)) ] && [ "$frozen_notified" -eq 0 ]; then
+    msg="GLM-5.2 ${RUN} FROZEN: no trainer step and no batch progress for ${FREEZE_MIN} min (step ${n}, batch ${b})"
+    log "FREEZE detected"
+    send "$msg"
+    call "GLM training run frozen. No progress for ${FREEZE_MIN} minutes."
+    frozen_notified=1
+    stuck=0
+  fi
+
+  sleep "$INTERVAL"
+done
diff --git a/scripts/ops/watchdog_smoketest.sh b/scripts/ops/watchdog_smoketest.sh
new file mode 100755
index 0000000..6e744f1
--- /dev/null
+++ b/scripts/ops/watchdog_smoketest.sh
@@ -0,0 +1,69 @@
+#!/usr/bin/env bash
+# Smoke-test the watchdog decision logic against every failure mode we have
+# actually hit, using fake probe results so nothing real is touched.
+#
+# The bug this exists to prevent: on 2026-08-06 the tunnel watchdog spent 2.6
+# hours rebuilding all 24 tunnels while both vLLM engines were dead, because a
+# dead engine and a wedged tunnel are indistinguishable from n82. Case 4 is
+# that exact scenario.
+set -uo pipefail
+
+pass=0; fail=0
+check() { # name expected actual
+  if [ "$2" = "$3" ]; then echo "  PASS  $1"; pass=$((pass+1))
+  else echo "  FAIL  $1 (expected '$2', got '$3')"; fail=$((fail+1)); fi
+}
+
+# Mirror of the tunnel watchdog's decision: given N failures out of TOTAL,
+# does it rebuild tunnels, blame the backend, or do nothing?
+decide() { # nfail total pct
+  local nfail=$1 total=$2 pct=${3:-80}
+  [ "$nfail" -eq 0 ] && { echo "none"; return; }
+  [ $((nfail * 100 / total)) -ge "$pct" ] && { echo "backend"; return; }
+  echo "rebuild"
+}
+
+echo "== tunnel watchdog decision logic =="
+check "all healthy -> no action"                 "none"    "$(decide 0 24)"
+check "1 wedged -> rebuild"                      "rebuild" "$(decide 1 24)"
+check "11 wedged (46%) -> rebuild"               "rebuild" "$(decide 11 24)"
+check "19 wedged (79%) -> rebuild"               "rebuild" "$(decide 19 24)"
+check "20 down (83%) -> blame backend"           "backend" "$(decide 20 24)"
+check "24 down (100%) -> blame backend"          "backend" "$(decide 24 24)"
+check "the 2026-08-06 outage (0/24 up)"          "backend" "$(decide 24 24)"
+check "the 22-of-24 wedge (92%) -> backend"      "backend" "$(decide 22 24)"
+
+# Two consecutive misses required before killing, so a single slow reply
+# under load does not trigger a needless rebuild.
+echo "== debounce =="
+debounce() { # miss_count
+  [ "$1" -ge 2 ] && echo "kill" || echo "wait"
+}
+check "1 slow reply -> wait"                     "wait"    "$(debounce 1)"
+check "2 consecutive misses -> kill"             "kill"    "$(debounce 2)"
+
+# Engine watchdog: container Up must NOT count as healthy. Only HTTP 200 does.
+echo "== engine watchdog health signal =="
+# Health is decided by an actual generation, NOT by container state and NOT by
+# /v1/models. h200a on 2026-08-06 06:05 had models=200 with gen=000: API server
+# alive, EngineCore hung at "Running: 64, throughput: 0.0".
+engine_healthy() { # gen_code models_code container_state
+  [ "$1" = "200" ] && echo "healthy" || echo "dead"
+}
+check "gen 200, models 200, up -> healthy"        "healthy" "$(engine_healthy 200 200 up)"
+check "gen 000, models 200, up -> dead (hung core)" "dead"  "$(engine_healthy 000 200 up)"
+check "gen 000, models 000, up -> dead"           "dead"    "$(engine_healthy 000 000 up)"
+check "gen 000, models 000, exited -> dead"       "dead"    "$(engine_healthy 000 000 exited)"
+check "gen 500 -> dead"                           "dead"    "$(engine_healthy 500 200 up)"
+check "gen times out (000) despite models ok"     "dead"    "$(engine_healthy 000 200 up)"
+
+echo "== engine watchdog restart threshold =="
+eng_action() { # misses threshold
+  [ "$1" -ge "$2" ] && echo "restart" || echo "wait"
+}
+check "1 miss -> wait"                           "wait"    "$(eng_action 1 2)"
+check "2 misses -> restart"                      "restart" "$(eng_action 2 2)"
+
+echo
+echo "passed=$pass failed=$fail"
+[ "$fail" -eq 0 ]
