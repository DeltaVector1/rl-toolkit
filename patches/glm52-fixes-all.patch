 local_port=${2:?usage: start_tunnel.sh REMOTE_PORT LOCAL_PORT}
 health_port=$((remote_port + 1000))
 
+# Keepalive: 15s x 8 = a dead TCP path is reaped in ~120s.
+#
+# This value has now been set three ways, and each was right for the watchdog
+# that existed at the time. 15 x 20 (300s) was chosen when nothing else could
+# detect a wedge, and it let wedged tunnels pile up. 10 x 3 (30s) replaced it,
+# but SSH keepalives are ordinary packets on a link that loses 10-33% of them,
+# so three consecutive misses happen routinely on a tunnel that is working --
+# and under load they miss on every tunnel at once. SSH was then killing live
+# tunnels and every request in flight on them.
+#
+# scripts/china/tunnel_watchdog.sh now owns wedge detection from the n82 side,
+# where it can see the thing SSH cannot: forward alive, no data flowing. So
+# SSH's only job here is to notice a genuinely dead TCP path, and it should be
+# patient about it. Exactly one of the two may be impatient; right now neither
+# is, because a wedge is expensive to misdiagnose in both directions.
+#
+# Compression is the reason this link works at all. On the batch tunnel it took
+# throughput from under 130 KB/s to 4.9 MB/s. Rollout traffic is JSON holding
+# generated text, which compresses just as well, and on a loss-limited path
+# fewer bytes means proportionally fewer lost packets. It costs a little CPU on
+# hosts that have plenty.
 while true; do
   ssh -o BatchMode=yes -o ConnectTimeout=30 china-trainer \
     "sudo ss -H -lntp 'sport = :$remote_port' | sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p' | xargs -r sudo kill; sudo ss -H -lntp 'sport = :$health_port' | sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p' | xargs -r sudo kill" || true
@@ -13,9 +34,10 @@ while true; do
     -o ConnectTimeout=30 \
     -o ExitOnForwardFailure=yes \
     -o ServerAliveInterval=15 \
-    -o ServerAliveCountMax=20 \
+    -o ServerAliveCountMax=8 \
     -o TCPKeepAlive=yes \
     -o IPQoS=none \
+    -o Compression=yes \
     -R "127.0.0.1:$remote_port:127.0.0.1:$local_port" \
     -R "127.0.0.1:$health_port:127.0.0.1:8000" \
     china-trainer || true
diff --git a/scripts/network/tune_wan.sh b/scripts/network/tune_wan.sh
new file mode 100755
index 0000000..d4e6c51
--- /dev/null
+++ b/scripts/network/tune_wan.sh
@@ -0,0 +1,64 @@
+#!/usr/bin/env bash
+# Tune the TCP stack for the China <-> H200 path. Run on n82 and on each H200
+# host. Safe to run repeatedly. Needs sudo for sysctl only.
+#
+# Topology, which is why this is not obvious:
+#
+#   H200 (docker) --internet, 7.5% loss, 210ms RTT--> jump 202.101.73.12
+#                 --LAN--> n82 10.92.20.82
+#
+# The rollout responses travel H200 -> n82, so the H200 is the sender for the
+# bulk data. Congestion control is a sender-side choice, so the algorithm that
+# matters most is the H200's. BBR cannot be loaded there: the "hosts" are
+# Docker containers (systemd-detect-virt reports docker) with no
+# CAP_SYS_MODULE, and the underlying host has not loaded tcp_bbr either.
+#
+# On n82 BBR is applied PER ROUTE, only for the two engine hosts. Do not set it
+# globally. n82 is also a trainer node and its NCCL all-to-all crosses the same
+# interface, where cubic measured 87% wire efficiency against BBR's 36%. See
+# docs/PERFORMANCE.md.
+set -uo pipefail
+
+ENGINE_IPS=${ENGINE_IPS:-"152.236.142.239 152.236.142.243"}
+ROLE=${1:-auto}
+
+if [ "$ROLE" = "auto" ]; then
+  if [ -d /data/glm52-rl/deployment/scripts/china ] && ip -brief addr | grep -q '10\.92\.20\.'; then
+    ROLE=trainer
+  else
+    ROLE=engine
+  fi
+fi
+
+say() { echo "$(date -u +%H:%M:%S) $*"; }
+
+# Both ends. An idle keep-alive socket restarts in slow start, and on a 210ms
+# RTT that costs several round trips before it carries data again. Rollout
+# connections idle between requests constantly. PERFORMANCE.md records this
+# setting makes no measurable difference to NCCL, so it is safe on n82.
+sudo sysctl -qw net.ipv4.tcp_slow_start_after_idle=0
+# Recover from an MTU black hole instead of stalling.
+sudo sysctl -qw net.ipv4.tcp_mtu_probing=1
+# 210ms x a few hundred Mbit needs far more than the 6 MB default ceiling.
+sudo sysctl -qw net.ipv4.tcp_rmem="4096 131072 33554432"
+sudo sysctl -qw net.ipv4.tcp_wmem="4096 65536 33554432"
+say "$ROLE: slow_start_after_idle=0 mtu_probing=1 rmem/wmem ceiling 32MB"
+
+if [ "$ROLE" = "trainer" ]; then
+  if sudo modprobe tcp_bbr 2>/dev/null; then
+    gw=$(ip route get "${ENGINE_IPS%% *}" 2>/dev/null | sed -n 's/.*via \([0-9.]*\).*/\1/p')
+    dev=$(ip route get "${ENGINE_IPS%% *}" 2>/dev/null | sed -n 's/.*dev \([^ ]*\).*/\1/p')
+    if [ -n "$gw" ] && [ -n "$dev" ]; then
+      for ip in $ENGINE_IPS; do
+        sudo ip route replace "$ip" via "$gw" dev "$dev" congctl bbr 2>/dev/null \
+          && say "route $ip -> bbr (global cc stays $(sysctl -n net.ipv4.tcp_congestion_control))"
+      done
+    else
+      say "WARNING: could not resolve gateway/device for the engine routes"
+    fi
+  else
+    say "WARNING: tcp_bbr will not load; leaving the engine routes on cubic"
+  fi
+fi
+
+say "done"
diff --git a/scripts/ops/sweep_inflight.sh b/scripts/ops/sweep_inflight.sh
new file mode 100755
index 0000000..e4362f7
--- /dev/null
+++ b/scripts/ops/sweep_inflight.sh
@@ -0,0 +1,112 @@
+#!/usr/bin/env bash
+# Measure rollout collection rate at one max_inflight_rollouts value.
+# Runs from the operator workstation. One value per invocation.
+#
+#   VALUE=192 WARMUP=180 WINDOW=480 bash scripts/ops/sweep_inflight.sh
+#
+# Changing max_inflight_rollouts needs an orchestrator restart, and a restart
+# discards whatever the current batch has collected, so each measurement costs
+# one partial batch. Skip the warmup window: a fresh batch ramps from zero and
+# the opening burst reads high.
+#
+# Rate is accepted rollouts per minute. Accepted advances in group_size steps,
+# so a window shorter than a few groups quantizes badly -- keep WINDOW >= 480s.
+set -uo pipefail
+
+VALUE=${VALUE:?set VALUE, the max_inflight_rollouts to test}
+# Warm up until the batch is really running, not for a fixed time. A restarted
+# orchestrator starts at accepted=0, each rollout takes minutes, and acceptance
+# is group-granular, so nothing is accepted for the first several minutes. A
+# fixed 180s warmup opened the window at accepted=0 and measured the ramp: it
+# read 2/min where the steady rate was 14/min.
+MIN_ACCEPTED=${MIN_ACCEPTED:-64}
+WARMUP_MAX=${WARMUP_MAX:-900}
+WINDOW=${WINDOW:-480}
+TAG=${CONFIG_TAG:-.x24}
+HEAD=${HEAD:-n82}
+DEPLOY=/data/glm52-rl/deployment
+CFG=$DEPLOY/configs/china/orchestrator$TAG.toml
+ORCH=glm52-decensor-orchestrator
+RESULTS=${RESULTS:-/tmp/inflight_sweep.tsv}
+
+say() { echo "$(date -u +%H:%M:%S) $*"; }
+sh_() { ssh -o BatchMode=yes -o ConnectTimeout=25 "$HEAD" "$@"; }
+
+accepted() {
+  sh_ "sudo docker logs --tail 60 $ORCH 2>&1 \
+       | grep -oE 'batch [0-9]+/[0-9]+' | tail -1 | grep -oE '[0-9]+' | head -1"
+}
+timeouts_since() { # minutes
+  sh_ "sudo docker logs --since ${1}m $ORCH 2>&1 | grep -ca 'ReadTimeout' || true"
+}
+engine_running() {
+  for h in h200a h200b; do
+    ssh -o BatchMode=yes -o ConnectTimeout=20 "$h" \
+      "sudo docker logs --tail 30 glm52-decensor-h200 2>&1 \
+       | grep -aoE 'Running: [0-9]+' | tail -1 | grep -oE '[0-9]+'" 2>/dev/null
+  done | paste -sd+ - | bc 2>/dev/null || echo 0
+}
+
+# Measure the value already running, without paying for a restart. Use this
+# when a previous run left the orchestrator at the value under test.
+if [ "${SKIP_RESTART:-0}" = "1" ]; then
+  say "SKIP_RESTART: measuring the running orchestrator at $VALUE"
+  sh_ "grep -m1 max_inflight_rollouts $CFG"
+else
+
+say "setting max_inflight_rollouts = $VALUE"
+sh_ "sudo sed -i 's/^max_inflight_rollouts = .*/max_inflight_rollouts = $VALUE/' $CFG && grep -m1 max_inflight_rollouts $CFG"
+
+# Let run_supervisor.sh own the restart rather than racing it.
+say "restarting the orchestrator"
+sh_ "sudo docker rm -f $ORCH >/dev/null 2>&1; echo removed"
+for _ in $(seq 1 24); do
+  sleep 10
+  [ "$(sh_ "sudo docker ps --filter name=$ORCH --format up | head -1")" = "up" ] && break
+done
+if [ "$(sh_ "sudo docker ps --filter name=$ORCH --format up | head -1")" != "up" ]; then
+  say "ABORT: orchestrator did not come back"
+  exit 1
+fi
+fi
+
+say "warming up until accepted >= $MIN_ACCEPTED (max ${WARMUP_MAX}s)"
+warm_start=$(date -u +%s)
+while : ; do
+  a=$(accepted); a=${a:-0}
+  now=$(date -u +%s)
+  [ "$a" -ge "$MIN_ACCEPTED" ] && { say "warm at accepted=$a after $((now - warm_start))s"; break; }
+  if [ $((now - warm_start)) -ge "$WARMUP_MAX" ]; then
+    say "WARNING: only accepted=$a after ${WARMUP_MAX}s; measuring anyway"
+    break
+  fi
+  sleep 30
+done
+
+s=$(accepted); t0=$(date -u +%s)
+say "window open at accepted=$s"
+sleep "$WINDOW"
+e=$(accepted); t1=$(date -u +%s)
+run=$(engine_running)
+to=$(timeouts_since $(( (WINDOW + 59) / 60 )) )
+
+if [ -z "$s" ] || [ -z "$e" ] || [ "$e" -lt "$s" ]; then
+  say "DISCARD: batch rolled over during the window (start=$s end=$e). Re-run."
+  exit 2
+fi
+
+python3 - "$VALUE" "$s" "$e" "$((t1 - t0))" "$to" "$run" "$RESULTS" <<'PY'
+import sys, pathlib
+val, s, e, dt, to, run, out = sys.argv[1:]
+s, e, dt, to, run = int(s), int(e), int(dt), int(to), int(run)
+rate = (e - s) / (dt / 60)
+line = f"{val}\t{e-s}\t{dt/60:.1f}\t{rate:.2f}\t{1024/rate if rate else 0:.0f}\t{to/(dt/60):.2f}\t{run}"
+print(f"inflight={val}  accepted={e-s} in {dt/60:.1f}min  "
+      f"rate={rate:.2f}/min  batch1024={1024/rate if rate else 0:.0f}min  "
+      f"timeouts={to/(dt/60):.2f}/min  engines_running={run}")
+p = pathlib.Path(out)
+if not p.exists():
+    p.write_text("inflight\taccepted\tminutes\trate_per_min\tbatch1024_min\ttimeouts_per_min\tengines_running\n")
+with p.open("a") as f:
+    f.write(line + "\n")
+PY
diff --git a/scripts/ops/watchdog_smoketest.sh b/scripts/ops/watchdog_smoketest.sh
new file mode 100755
index 0000000..60e1485
--- /dev/null
+++ b/scripts/ops/watchdog_smoketest.sh
@@ -0,0 +1,262 @@
+#!/usr/bin/env bash
+# Drive the REAL watchdog scripts against a fake environment and assert on what
+# they actually do. Nothing real is touched: curl, ss, kill, sudo, docker,
+# nvidia-smi and sleep are all shadowed on PATH.
+#
+# The previous version of this file re-implemented each watchdog's decision as
+# a local shell function and tested THAT. It passed 18 of 18 while asserting
+# the opposite of the shipped behaviour: three cases still expected the tunnel
+# watchdog to refuse to rebuild on mass failure, a rule that was removed after
+# it froze the run for five hours. A test that mirrors the logic cannot catch a
+# change to the logic. Every case below runs the real script.
+set -uo pipefail
+
+ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
+TUNNEL_WD=$ROOT/scripts/china/tunnel_watchdog.sh
+ENGINE_WD=$ROOT/scripts/h200/engine_watchdog.sh
+
+pass=0; fail=0
+check() { # name expected actual
+  if [ "$2" = "$3" ]; then echo "  PASS  $1"; pass=$((pass+1))
+  else echo "  FAIL  $1 (expected '$2', got '$3')"; fail=$((fail+1)); fi
+}
+contains() { # name haystack-file needle
+  if grep -q -- "$3" "$2" 2>/dev/null; then echo "  PASS  $1"; pass=$((pass+1))
+  else echo "  FAIL  $1 (log has no '$3')"; fail=$((fail+1)); fi
+}
+absent() { # name haystack-file needle
+  if grep -q -- "$3" "$2" 2>/dev/null; then echo "  FAIL  $1 (log unexpectedly has '$3')"; fail=$((fail+1))
+  else echo "  PASS  $1"; pass=$((pass+1)); fi
+}
+
+# ---------------------------------------------------------------- fake world
+
+FIX=$(mktemp -d)
+trap 'rm -rf "$FIX"' EXIT
+BIN=$FIX/bin; mkdir -p "$BIN"
+
+# curl: hands the URL to the per-case responder and prints only an HTTP code,
+# which is all these scripts ask of it (-o /dev/null -w '%{http_code}').
+cat > "$BIN/curl" <<'EOF'
+#!/usr/bin/env bash
+url=""
+for a in "$@"; do case "$a" in http*) url=$a ;; esac; done
+port=$(printf '%s' "$url" | sed -n 's|.*://[^:]*:\([0-9]*\)/.*|\1|p')
+kind=tunnel
+case "$url" in *completions*) kind=engine ;; esac
+echo "$kind $port" >> "$FIX/probed"
+# shellcheck disable=SC1090
+. "$FIX/respond.sh"
+respond "$kind" "$port"
+EOF
+
+# ss: reports which pid holds a listening port. Ports listed in $FIX/unheld
+# have nothing behind them, which is the "remote supervisor down" case.
+cat > "$BIN/ss" <<'EOF'
+#!/usr/bin/env bash
+port=$(printf '%s' "$*" | sed -n 's/.*sport = :\([0-9]*\).*/\1/p')
+grep -qx "$port" "$FIX/unheld" 2>/dev/null && exit 0
+echo "LISTEN 0 128 127.0.0.1:$port 0.0.0.0:* users:((\"sshd\",pid=$((9000+port%1000)),fd=9))"
+EOF
+
+cat > "$BIN/kill" <<'EOF'
+#!/usr/bin/env bash
+for a in "$@"; do case "$a" in [0-9]*) echo "$a" >> "$FIX/killed" ;; esac; done
+EOF
+
+cat > "$BIN/sudo" <<'EOF'
+#!/usr/bin/env bash
+exec "$@"
+EOF
+
+cat > "$BIN/docker" <<'EOF'
+#!/usr/bin/env bash
+echo "$*" >> "$FIX/docker"
+EOF
+
+cat > "$BIN/nvidia-smi" <<'EOF'
+#!/usr/bin/env bash
+echo "1 MiB"
+EOF
+
+# sleep: counts loop iterations and stops the script under test after MAXCYCLES,
+# so each case runs an exact, known number of cycles instead of a timeout race.
+cat > "$BIN/sleep" <<'EOF'
+#!/usr/bin/env bash
+n=$(( $(cat "$FIX/cycles" 2>/dev/null || echo 0) + 1 ))
+echo "$n" > "$FIX/cycles"
+[ "$n" -ge "${MAXCYCLES:-2}" ] && kill -TERM "$PPID" 2>/dev/null
+exit 0
+EOF
+
+chmod +x "$BIN"/*
+export FIX PATH="$BIN:$PATH"
+
+reset() { : > "$FIX/probed"; : > "$FIX/killed"; : > "$FIX/docker"; : > "$FIX/unheld"; rm -f "$FIX/cycles"; }
+nkilled() { wc -l < "$FIX/killed" | tr -d ' '; }
+
+# ------------------------------------------------------- tunnel watchdog
+
+run_tunnel() { # ports... ; needs $FIX/respond.sh and $MAXCYCLES
+  # The brace group swallows the shell's "Terminated" notice: the fake sleep
+  # ends each case by signalling the script under test, and the reporting shell
+  # is this one, not the child.
+  { PORTS="$*" TIMEOUT=1 INTERVAL=1 HEARTBEAT="${HEARTBEAT:-1}" MASS_FAILURE_PCT=80 \
+    MISSES_BEFORE_KILL="${MISSES:-2}" MAX_KILLS_PER_PASS="${CAP:-99}" KILL_COOLDOWN="${COOL:-0}" \
+      timeout 30 bash "$TUNNEL_WD" > "$FIX/log" 2>&1; } 2>/dev/null
+}
+P24=$(seq 18001 18024 | tr '\n' ' ')
+
+echo "== tunnel watchdog: real script, faked probes =="
+
+reset; echo 'respond() { echo 200; }' > "$FIX/respond.sh"
+MAXCYCLES=2 run_tunnel $P24
+check "24 healthy -> nothing killed"              "0"  "$(nkilled)"
+contains "24 healthy -> heartbeat proves it ran"  "$FIX/log" "heartbeat: 24/24 tunnels healthy"
+
+reset; echo 'respond() { [ "$2" = 18007 ] && echo 000 || echo 200; }' > "$FIX/respond.sh"
+MAXCYCLES=2 run_tunnel $P24
+check "1 wedged, 2 misses -> exactly 1 kill"      "1"  "$(nkilled)"
+contains "1 wedged -> names the port"             "$FIX/log" "killed wedged tunnel on :18007"
+
+# Debounce: one slow reply under load must not cost a rebuild.
+reset
+cat > "$FIX/respond.sh" <<'EOF'
+respond() {
+  c=$(cat "$FIX/cycles" 2>/dev/null || echo 0)
+  if [ "$2" = 18007 ] && [ "$c" = 0 ]; then echo 000; else echo 200; fi
+}
+EOF
+MAXCYCLES=3 run_tunnel $P24
+check "1 miss then healthy -> no kill"            "0"  "$(nkilled)"
+
+# The miss threshold must actually hold the port back until it is reached.
+reset; echo 'respond() { [ "$2" = 18007 ] && echo 000 || echo 200; }' > "$FIX/respond.sh"
+MISSES=6 MAXCYCLES=3 run_tunnel $P24
+check "wedged 3 cycles, threshold 6 -> no kill"   "0"  "$(nkilled)"
+reset; echo 'respond() { [ "$2" = 18007 ] && echo 000 || echo 200; }' > "$FIX/respond.sh"
+MISSES=6 MAXCYCLES=7 run_tunnel $P24
+check "wedged 7 cycles, threshold 6 -> 1 kill"    "1"  "$(nkilled)"
+
+# Mass failure must still act -- an earlier rule refused to rebuild above 80%
+# failure and froze the run for five hours -- but it must NOT tear down every
+# tunnel at once. At 251 rollouts in flight the probe starves on live tunnels,
+# and killing them destroys every rollout they carry.
+reset; echo 'respond() { echo 000; }' > "$FIX/respond.sh"
+CAP=2 MAXCYCLES=2 run_tunnel $P24
+check "24 wedged -> acts, capped at 2 per pass"   "2"  "$(nkilled)"
+contains "24 wedged -> warns about the backend"   "$FIX/log" "check the engines too, but rebuilding regardless"
+absent  "24 wedged -> does not refuse to act"     "$FIX/log" "not rebuilding"
+contains "24 wedged -> reports what it deferred"  "$FIX/log" "deferred"
+
+# The cooldown must stop a second pass from firing immediately after the first.
+reset; echo 'respond() { echo 000; }' > "$FIX/respond.sh"
+CAP=2 COOL=999 MAXCYCLES=5 run_tunnel $P24
+check "cooldown holds later passes to 2 total"    "2"  "$(nkilled)"
+
+# A deferred port must stay a candidate. If the miss count were reset when the
+# rate limit skipped it, a wedged tunnel would never be rebuilt at all.
+reset; echo 'respond() { echo 000; }' > "$FIX/respond.sh"
+CAP=2 COOL=0 MAXCYCLES=4 run_tunnel $P24
+kills=$(nkilled)
+if [ "$kills" -ge 4 ]; then echo "  PASS  deferred ports stay candidates ($kills killed over 4 passes)"; pass=$((pass+1))
+else echo "  FAIL  deferred ports stay candidates (only $kills killed over 4 passes)"; fail=$((fail+1)); fi
+
+reset; echo 'respond() { [ "$2" = 18007 ] && echo 000 || echo 200; }' > "$FIX/respond.sh"
+echo 18007 > "$FIX/unheld"
+MAXCYCLES=2 run_tunnel $P24
+check "wedged with nothing on the port -> no kill" "0" "$(nkilled)"
+contains "wedged, unheld -> says so"              "$FIX/log" "nothing holds the port"
+
+# The batch tunnel carries the zmq stream to the trainer. Killing it under a
+# live orchestrator left seven dead connections and starved the trainer for 27
+# minutes, so this watchdog must never probe or touch it.
+reset; echo 'respond() { echo 000; }' > "$FIX/respond.sh"
+MAXCYCLES=2 run_tunnel $P24
+absent "batch port 29620 is never probed"         "$FIX/probed" "29620"
+absent "batch port 29620 is never killed"         "$FIX/killed" "29620"
+
+# ------------------------------------------------------- engine watchdog
+
+run_engine() { # needs $FIX/respond.sh and $MAXCYCLES
+  { PORT=8000 INTERVAL=1 TIMEOUT=1 FAILS_BEFORE_RESTART=2 \
+    START="$FIX/fake_start.sh" RELOAD_TRIES=2 RELOAD_WAIT=1 \
+      timeout 30 bash "$ENGINE_WD" > "$FIX/log" 2>&1; } 2>/dev/null
+}
+printf '#!/usr/bin/env bash\necho started >> "$FIX/docker"\n' > "$FIX/fake_start.sh"
+chmod +x "$FIX/fake_start.sh"
+
+echo "== engine watchdog: real script, faked engine =="
+
+reset; echo 'respond() { echo 200; }' > "$FIX/respond.sh"
+MAXCYCLES=3 run_engine
+absent "generation ok -> no restart"              "$FIX/log" "RESTARTING ENGINE"
+contains "generation ok -> probes a completion"   "$FIX/probed" "engine 8000"
+
+# The 2026-08-06 06:05 failure on h200a: /v1/models answered 200 while the
+# EngineCore was hung at "Running: 64, throughput: 0.0". Container state and
+# /v1/models are both useless here; only a generation proves anything.
+reset; echo 'respond() { [ "$1" = engine ] && echo 000 || echo 200; }' > "$FIX/respond.sh"
+MAXCYCLES=3 run_engine
+contains "gen 000 while models 200 -> restarts"   "$FIX/log" "RESTARTING ENGINE"
+contains "restart removes the container first"    "$FIX/docker" "rm -f glm52-decensor-h200"
+contains "restart runs the launcher"              "$FIX/docker" "started"
+
+reset; echo 'respond() { [ "$1" = engine ] && echo 500 || echo 200; }' > "$FIX/respond.sh"
+MAXCYCLES=3 run_engine
+contains "gen 500 -> restarts"                    "$FIX/log" "RESTARTING ENGINE"
+
+reset
+cat > "$FIX/respond.sh" <<'EOF'
+respond() {
+  c=$(cat "$FIX/cycles" 2>/dev/null || echo 0)
+  if [ "$1" = engine ] && [ "$c" = 0 ]; then echo 000; else echo 200; fi
+}
+EOF
+MAXCYCLES=3 run_engine
+absent  "1 miss then recovery -> no restart"      "$FIX/log" "RESTARTING ENGINE"
+contains "1 miss then recovery -> logs recovery"  "$FIX/log" "engine recovered"
+
+# After a restart it must confirm with a generation, not with /v1/models.
+reset
+cat > "$FIX/respond.sh" <<'EOF'
+respond() {
+  n=$(( $(cat "$FIX/n" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$FIX/n"
+  [ "$n" -le 2 ] && echo 000 || echo 200
+}
+EOF
+rm -f "$FIX/n"
+MAXCYCLES=4 run_engine
+contains "post-restart health is a generation"    "$FIX/log" "engine back up (generation verified)"
+
+# ------------------------------------------- liveness probes must not self-match
+
+# `pgrep -f X` run through `ssh host "..."` or `bash -c "..."` matches the very
+# shell running it, because X sits in that command line. The count is then never
+# zero and every liveness test passes. `pgrep -fc` has the same fault plus one:
+# it counts its own grep. This hid three dead watchdogs for 3 hours, and killed
+# all three again on 2026-08-07 when a `pkill -f` matched its own ssh session.
+#
+# Bracketing the FIRST word is not enough. The shell really is `bash`, so
+# `[b]ash .*name.sh` still matches through the literal leading `bash ` and the
+# `.*`. The distinctive last token is what must be bracketed.
+echo "== liveness probes must not match themselves =="
+
+naive=$(bash -c 'pgrep -f "bash .*no_such_proc_zzz.sh" | wc -l' | tr -d ' ')
+check "the naive pattern matches its own shell"  "1" "$naive"
+
+first=$(bash -c 'pgrep -f "[b]ash .*no_such_proc_zzz.sh" | wc -l' | tr -d ' ')
+check "bracketing the first word does not help"  "1" "$first"
+
+fixed=$(bash -c 'pgrep -f "bash .*[n]o_such_proc_zzz.sh" | wc -l' | tr -d ' ')
+check "bracketing the last token works"          "0" "$fixed"
+
+if command -v python3 >/dev/null; then
+  helper=$(PYTHONPATH="$ROOT/.agents/skills/glm52-ops/src" python3 -c \
+    'import glm52_ops; print(glm52_ops._no_self_match("bash .*tunnel_watchdog.sh"))' 2>/dev/null)
+  check "the skill helper brackets the last token" "bash .*[t]unnel_watchdog.sh" "$helper"
+fi
+
+echo
+echo "passed=$pass failed=$fail"
+[ "$fail" -eq 0 ]
