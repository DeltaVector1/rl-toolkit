         raise ValueError("routing_replay_out must be contiguous (packed row-major)")
 
 
+def _validate_routing_weights_replay_out(
+    routing_weights_replay_out: Optional[torch.Tensor],
+    routing_logits: torch.Tensor,
+    top_k: int,
+) -> None:
+    if routing_weights_replay_out is None:
+        return
+    expected = (routing_logits.shape[0], top_k)
+    if routing_weights_replay_out.shape != expected:
+        raise ValueError(
+            f"routing_weights_replay_out must have shape {expected}, "
+            f"got {tuple(routing_weights_replay_out.shape)}"
+        )
+    if routing_weights_replay_out.dtype != torch.float32:
+        raise ValueError("routing_weights_replay_out must be float32")
+    if routing_logits.dtype != torch.float32:
+        raise ValueError("routing weights replay requires float32 routing logits")
+    if routing_weights_replay_out.device != routing_logits.device:
+        raise ValueError("routing weights replay must use the routing logits device")
+    if not routing_weights_replay_out.is_contiguous():
+        raise ValueError("routing_weights_replay_out must be contiguous")
+
