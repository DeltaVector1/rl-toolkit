From 009e64ac6120f4b82b26ea0f98643c73dee688ce Mon Sep 17 00:00:00 2001
From: DeltaVector1 <DeltaVector1@users.noreply.github.com>
Date: Fri, 7 Aug 2026 17:06:26 +0000
Subject: [PATCH 35/35] Start run x25 clean with router replay off; fix two
 faults it exposed

Restarting the trainer at step 10 lost every step. ckpt.interval was 25, so no
checkpoint had ever been written, and weights_only=true cannot resume training
even when one exists. x25 uses interval=5 and weights_only=false. The step-10
adapter still exists under broadcasts/step_10 if it is ever wanted.

start() left the previous run's supervisor alive. It watches the container by
name, so after a run change it sits quiet until the trainer dies and then
relaunches it under the OLD run name. Three supervisors carrying RUN=x24 were
found running against x25. start() now kills them first, in a separate
connection, and reports the count.

x25 carries everything measured today: router replay off, 128 in flight, 48
tunnels, compression, bounded 300s timeouts, and the WAN tuning.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017wiESxhziDrnsLnG9aizTd
---
 .../glm52-ops/src/glm52_ops/__init__.py       |  12 ++
 configs/china/orchestrator.x25.toml           | 147 ++++++++++++++++++
 configs/china/trainer.x24.toml                |  11 +-
 configs/china/trainer.x25.toml                | 143 +++++++++++++++++
 4 files changed, 312 insertions(+), 1 deletion(-)
 create mode 100644 configs/china/orchestrator.x25.toml
 create mode 100644 configs/china/trainer.x25.toml

diff --git a/.agents/skills/glm52-ops/src/glm52_ops/__init__.py b/.agents/skills/glm52-ops/src/glm52_ops/__init__.py
index ed064e5..f6c7af1 100644
--- a/.agents/skills/glm52-ops/src/glm52_ops/__init__.py
+++ b/.agents/skills/glm52-ops/src/glm52_ops/__init__.py
@@ -884,11 +884,23 @@ def start(run: str, mode: str = "cold", nodes: list[str] | None = None, supervis
         launch_orch()
 
     if supervisors:
+        # Kill any supervisor from a previous run FIRST. It holds the old RUN in
+        # its environment, and it watches the container by name, so after a
+        # switch to a new run name it sits quiet until the trainer dies and then
+        # relaunches it under the OLD run. Observed on 2026-08-07: three
+        # supervisors survived a run change, all carrying RUN=x24.
+        # Separate connections: a pkill and a start in one command line makes the
+        # pkill pattern match its own shell.
+        _ssh(HEAD, "pkill -f '[r]un_supervisor.sh' 2>/dev/null; echo done")
+        time.sleep(3)
         _ssh(
             HEAD,
             f"nohup setsid env RUN={run} RUN_NAME={name} CONFIG_TAG={tag} INTERVAL=120 "
             f"bash {DEPLOY}/scripts/china/run_supervisor.sh >> /data/glm52-rl/run_supervisor.log 2>&1 </dev/null & disown",
         )
+        time.sleep(3)
+        n = _ssh(HEAD, "pgrep -f 'bash .*[r]un_supervisor.sh' | wc -l")[1].strip()
+        print(f"run supervisor: {n} process(es) for {run}")
         _repair_supervisors()
     print(f"started {run} in {mode} mode. Call status() in a few minutes.")
 
