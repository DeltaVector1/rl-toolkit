+class NativeFP8MultiLoRAGroupedExperts(MultiLoRAModule):
+    """Standard expert LoRA with a frozen native block-FP8 base."""
+
+    requires_received_int4_input = True
+    fp8_checkpoint = True
+
+    def __init__(
