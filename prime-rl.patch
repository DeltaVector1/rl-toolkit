+            x.shape[0] + local_experts * TOKEN_GROUP_ALIGN_SIZE_M,
+            TOKEN_GROUP_ALIGN_SIZE_M,
+        )
+    offsets = torch.cumsum(local_counts, 0, dtype=torch.int32)
+    return _InplacePermutedLoRAExperts.apply(
+        x,
+        w1,
+        s1,
+        w2,
+        s2,
+        w3,
+        s3,
+        w1_lora_a,
+        w1_lora_b,
+        w2_lora_a,
+        w2_lora_b,
+        w3_lora_a,
+        w3_lora_b,
+        scaling,
+        permuted_indices,
+        offsets,
+        owner,
+        received_input,
+        received_scores,
+        _FP8_W13_CHUNK_ROWS,
+    )
