+                local_layers[f"model.layers.{layer_index}.mlp.expert_bias"] = {
+                    "layer": int(layer_index),
+                    "dtype": str(source.dtype),
+                    "shape": list(source.shape),
+                    "sha256": hashlib.sha256(source_bytes).hexdigest(),
