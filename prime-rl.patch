+def download(
+    source_url: str,
+    destination: Path,
+    *,
+    expected_size: int | None = None,
+    expected_sha256: str | None = None,
+    progress=None,
+    source_urls: list[str] | None = None,
+    parallel_ranges: bool = True,
+    deadline: float | None = None,
